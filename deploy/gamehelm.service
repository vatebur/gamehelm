[Unit]
Description=GameHelm systemd and Docker service controller

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/gamehelm -config @PROJECT_DIR@/config.json
Restart=always
RestartSec=3s
UMask=0077
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamehelm

[Install]
WantedBy=default.target
